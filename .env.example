# Resend API Configuration
RESEND_API_KEY=re_your_api_key_here

# Recipient Email (where you want to receive new client inquiries)
CONTACT_TO_EMAIL=info@sensirupt.com

# Sender Email
# NOTE: While testing (or before verifying your domain on Resend), use:
CONTACT_FROM_EMAIL=Sensirupt Briefings <onboarding@resend.dev>

# Once you verify sensirupt.com on Resend, you can change this to:
# CONTACT_FROM_EMAIL=Sensirupt <briefings@sensirupt.com>
